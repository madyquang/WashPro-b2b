# Sao chép thành ".env" (cùng thư mục với docker-compose.yml) rồi chạy: docker compose up -d --build
# File .env chứa mật khẩu, không commit.

# Mật khẩu tài khoản root của MySQL trong container
DB_PASSWORD=doi-mat-khau-nay

# Khóa ký JWT, tối thiểu 32 ký tự (tạo ngẫu nhiên, VD: openssl rand -base64 48)
JWT_SECRET=thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu

# Tài khoản Quản lý xưởng đầu tiên (chỉ tạo khi CSDL chưa có quản lý xưởng)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=doi-mat-khau-nay

# true: sinh dữ liệu demo lần khởi động đầu (mật khẩu tài khoản demo 11111111). Không bật trên hệ thống thật.
DEMO_DATA=false

# Cổng mở giao diện trên máy: http://localhost:3000
APP_PORT=3000
