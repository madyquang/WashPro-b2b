# Sao chép thành ".env" (cùng thư mục với pom.xml) rồi điền giá trị thật. Không commit file .env.

# ===== Cơ sở dữ liệu (bắt buộc: DB_PASSWORD) =====
DB_URL=jdbc:mysql://localhost:3306/washpro_b2b?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=

# validate: Hibernate chỉ kiểm tra bảng khớp entity; cấu trúc bảng do Flyway quản lý (db/migration).
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# ===== JWT (bắt buộc, tối thiểu 32 ký tự) =====
JWT_SECRET=
# Thời hạn phiên đăng nhập (mili giây), mặc định 8 giờ
JWT_EXPIRATION_MS=28800000

# ===== Origin frontend được phép gọi API (nhiều giá trị ngăn cách bằng dấu phẩy) =====
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ===== Khóa tạm khi đăng nhập sai =====
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=5

# ===== Quản lý xưởng đầu tiên (chỉ dùng khi hệ thống chưa có quản lý xưởng nào; mật khẩu ≥ 8 ký tự) =====
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# ===== Dữ liệu demo: false | true | reset. Không bật trên hệ thống thật =====
DEMO_DATA=false
